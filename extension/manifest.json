{
  "manifest_version": 3,
  "name": "听懂 · Bilibili Mandarin Listening Room",
  "version": "0.3.0",
  "description": "Prepare Mandarin lessons for Bilibili videos: transcription, translation, pinyin, forced alignment and character meanings.",
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/lesson.json"
      ],
      "matches": [
        "https://www.bilibili.com/*",
        "https://m.bilibili.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Show / hide Mandarin learning panel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": "",
  "minimum_chrome_version": "110"
}
